# ==============================================================================
# LinkUp — example configuration
#
# Copy to .env for local development. In production these values are NOT read
# from a file next to the compose file: see DEPLOYMENT.md.
# ==============================================================================

# --- Server ---
LINKUP_PORT=3464
LINKUP_HOST=0.0.0.0
LINKUP_PUBLIC_HOST=link.example.com
LINKUP_DEFAULT_DOMAIN=link.example.com

# --- Session ---
# 32 characters or more. Generate one with: openssl rand -hex 32
LINKUP_SESSION_SECRET=__CHANGE_ME__32_chars_or_more__________

# --- OpenID Connect ---
# The discovery URL is the only provider address LinkUp needs; everything else
# —authorize, token, userinfo— is read from that document. Changing providers is
# changing this line.
# The ISSUER, not the discovery document: the library appends
# /.well-known/openid-configuration itself. A full discovery URL here is trimmed
# rather than left to produce a doubled path and a sign-in that fails at step one.
LINKUP_OIDC_ISSUER=https://auth.example.com/application/o/linkup/

# Optional: how THIS server reaches the provider, when that is not the public
# address. Two containers on one host talking through the public hostname go out
# to the internet and come back to reach a neighbour, and stop working when that
# path does. The browser is still sent to the public address.
# LINKUP_OIDC_INTERNAL_BASE=http://authentik:9000
LINKUP_OIDC_CLIENT_ID=__CHANGE_ME__
LINKUP_OIDC_CLIENT_SECRET=__CHANGE_ME__
LINKUP_OIDC_REDIRECT_URI=https://link.example.com/auth/callback
LINKUP_ENROLL_URL=https://auth.example.com/if/flow/enroll-linkup/
LINKUP_ACCOUNT_URL=https://auth.example.com/if/user/#/settings

# --- Administration ---
# Preferred: a group from the provider. Revoking is then removing someone from
# the group, with no file to edit and no restart.
# What the sign-in button calls your provider. Defaults to "your provider",
# which says nothing about who — this is a product other people run.
LINKUP_OIDC_PROVIDER_NAME=your provider

LINKUP_ADMIN_GROUP=linkup-admins
# Require this current UserInfo group for any authenticated access (optional).
LINKUP_REQUIRED_GROUP=linkup
# Fallback for providers that do not emit groups. Ignored whenever
# LINKUP_ADMIN_GROUP is set, so the two can never disagree.
# LINKUP_ADMIN_USERS=alice,bob

# --- Storage ---
LINKUP_DB_PATH=/data/linkup.db

# --- Integrations ---
LINKUP_QRFORGE_URL=https://qr.example.com

# --- Behaviour ---
# Allow shortening to reserved ranges (10/8, 192.168/16, …). Off by default: it
# is legitimate for an intranet instance and it is also how a shortener becomes
# a probe for someone else's network. Webhooks are never allowed there, with or
# without this.
LINKUP_ALLOW_PRIVATE_TARGETS=false

# Development only. With this on and OIDC unset, every request without a cookie
# is treated as an administrator — so the server refuses to start in that
# combination unless it is bound to loopback.
LINKUP_DEV_MODE=false
